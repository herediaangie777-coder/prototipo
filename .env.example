# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL base de la API REST. En local: http://localhost:3003
# En Render (producción): https://tu-api.onrender.com
VITE_API_URL=http://localhost:3003

# ── API (Express) ───────────────────────────────────────────────────────────
# Puerto del servidor Express. Render lo inyecta automáticamente.
PORT=3003

# ── Base de datos (Render: usar DATABASE_URL) ────────────────────────────────
DATABASE_URL=
DB_SSL=true

# Base de datos (local: usar variables individuales si no hay DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fresas
DB_USER=postgres
DB_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por comas.
# En local: http://localhost:8443,http://localhost:5173
# En Render: https://tu-frontend.onrender.com
CORS_ORIGIN=http://localhost:8443,http://localhost:5173
